Thumbs.db
*.jpg.tmp

# ---- 桌面回收站目录 ----
.Trash-*/

# ---- 临时凭证：图生3D 的 clientTempToken，绝不入库 ----
web/.tmp_ck*
*.tmp_ck*

# ---- Python / Node 缓存 ----
__pycache__/
*.pyc
web/node_modules/
web/npm/

# 仅 diag_test.mjs（CDP 自动化验证）临时用得到，非项目依赖
web/package.json
web/package-lock.json

# ---- 生成日志（含 job id，不含凭证但属运行产物）----
web/*.log

# ---- 图生3D 中间产物：原始直出与贴图压缩前的大文件 ----
