web/assets/aim_single/
web/assets/aim_15k/
web/assets/v2_15k/
web/assets/_archive/
web/assets/aim_src/
web/assets/dafeiyu_hires.glb
web/assets/qem_15k.glb
web/assets/manifest.json

# ---- 参考图与离线校验渲染图：可由脚本重新生成，不入库 ----
web/assets/ref/
web/assets/_ref/
web/assets/*_preview.png
# 截图产物（可由 shot.mjs 重新生成）
web/iso_view.png
